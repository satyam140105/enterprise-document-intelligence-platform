# Application
APP_NAME=docintel-api
APP_ENV=development
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=change-me

# Database
DATABASE_URL=postgresql+psycopg://docintel:docintel@localhost:5432/docintel

# Embeddings / LLM
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_PROVIDER=openai_compatible
LLM_MODEL=gpt-4o-mini
LLM_API_BASE=
LLM_API_KEY=

# Paths
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
MODEL_ARTIFACT_DIR=models/artifacts

# MLflow
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=document-intelligence
